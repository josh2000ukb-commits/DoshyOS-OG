#!/bin/sh
# doshy OS - Display and monitors.
# Applies a clean layout (no overlapping screens, no leftover panning) and then
# puts the wallpaper and taskbar back so the mouse matches what you see.
#
#   doshy-display          chooser
#   doshy-display --fixup  tidy up after any xrandr/arandr change
set -eu

connected_outputs() {
    xrandr --query 2>/dev/null | awk '/ connected/{ print $1 }'
}

# Preferred (or current) width x height for an output
output_mode() {
    # $1 = output name -> prints WIDTHxHEIGHT
    xrandr --query 2>/dev/null | awk -v o="$1" '
        $1 == o && $2 == "connected" { grab = 1; next }
        grab && $1 ~ /^[0-9]+x[0-9]+/ {
            if ($0 ~ /\+/) { preferred = $1; exit }
            if (!first) first = $1
        }
        grab && $1 !~ /^[0-9]/ && $1 != "" { exit }
        END { if (preferred) print preferred; else if (first) print first }
    '
}

reset_output() {
    # Clear panning / transform / scale that make the cursor miss the image
    xrandr --output "$1" --auto --rotate normal --panning 0x0 --transform none --scale 1x1 >/dev/null 2>&1 || \
        xrandr --output "$1" --auto --rotate normal >/dev/null 2>&1
}

fixup() {
    # Let xrandr compute the framebuffer; 0x0 is not a valid size.
    for o in $(connected_outputs); do
        xrandr --output "$o" --panning 0x0 --transform none --scale 1x1 >/dev/null 2>&1 || true
    done
    xsetroot -cursor_name left_ptr >/dev/null 2>&1 || true
    openbox --reconfigure >/dev/null 2>&1 || true
    if pgrep -u "$(id -u)" -x tint2 >/dev/null 2>&1; then
        pkill -u "$(id -u)" -x tint2
        sleep 0.2
    fi
    tint2 >/dev/null 2>&1 &
    doshy-wallpaper --restore >/dev/null 2>&1 || true
}

if [ "${1:-}" = "--fixup" ]; then
    fixup
    exit 0
fi

# --- build a layout from scratch (avoids overlapping leftovers) ---
apply_single() {
    keep="$1"
    for o in $(connected_outputs); do
        if [ "$o" = "$keep" ]; then
            mode="$(output_mode "$o")"
            [ -n "$mode" ] || return 1
            xrandr --output "$o" --off
            xrandr --output "$o" --mode "$mode" --primary --pos 0x0
        else
            xrandr --output "$o" --off
        fi
    done
    fixup
}

output_modes() {
    xrandr --query 2>/dev/null | awk -v o="$1" '
        $1 == o && $2 == "connected" { grab = 1; next }
        grab && $1 ~ /^[0-9]+x[0-9]+/ { print $1; next }
        grab { exit }
    '
}

apply_mirror() {
    # Mirroring different native resolutions crops part of the shared desktop.
    # Find a resolution every output supports before changing any output.
    set -- $(connected_outputs)
    [ "$#" -gt 0 ] || return 1
    primary="$1"
    mirror_mode=""
    for candidate in $(output_modes "$primary"); do
        shared=1
        for o in "$@"; do
            if ! output_modes "$o" | grep -Fxq "$candidate"; then shared=0; break; fi
        done
        if [ "$shared" = 1 ]; then mirror_mode="$candidate"; break; fi
    done
    if [ -z "$mirror_mode" ]; then
        zenity --error --title="Display and monitors" \
            --text="These screens have no common resolution for mirroring. Choose side by side or one screen only." 2>/dev/null || true
        return 1
    fi
    # Break any previous clone relationship before applying the new one.
    for o in "$@"; do xrandr --output "$o" --off || return 1; done
    for o in "$@"; do
        if [ "$o" = "$primary" ]; then
            xrandr --output "$o" --mode "$mirror_mode" --primary --pos 0x0
        else
            xrandr --output "$o" --mode "$mirror_mode" --same-as "$primary"
        fi
    done
    fixup
}

apply_row() {
    # $@ = outputs left to right, each at its native size, no overlap
    # Turn every output off first. This is required when coming from Mirror:
    # changing --pos on a cloned output can otherwise leave the old transform
    # and make a larger monitor display a cropped or scaled image.
    for o in "$@"; do xrandr --output "$o" --off || return 1; done
    x=0
    first=1
    for o in "$@"; do
        mode="$(output_mode "$o")"
        w="${mode%%x*}"
        case "$w" in ''|*[!0-9]*) return 1 ;; esac
        if [ "$first" = 1 ]; then
            xrandr --output "$o" --mode "$mode" --primary --pos "${x}x0" || return 1
            first=0
        else
            xrandr --output "$o" --mode "$mode" --pos "${x}x0" || return 1
        fi
        x=$((x + w))
    done
    fixup
}

outputs="$(connected_outputs)"
count="$(printf '%s\n' "$outputs" | grep -c . || true)"

if [ "${count:-0}" -lt 2 ]; then
    zenity --info --title="Display and monitors" --width=400 \
        --text="Only one screen is connected.\n\nPlug in another monitor and open this again to arrange them.\n(If it is already plugged in, try a different cable or the other HDMI/DisplayPort socket.)" \
        2>/dev/null || true
    # Still tidy the one screen
    for o in $outputs; do reset_output "$o"; xrandr --output "$o" --primary --pos 0x0; done
    fixup
    exit 0
fi

# Human-readable current layout
layout="$(xrandr --query | awk '/ connected/{
    name=$1
    if ($3 ~ /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
        split($3, a, /[x+]/)
        printf "  •  %s  %sx%s at %s,%s\n", name, a[1], a[2], a[3], a[4]
    } else if ($4 ~ /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
        split($4, a, /[x+]/)
        printf "  •  %s  %sx%s at %s,%s\n", name, a[1], a[2], a[3], a[4]
    } else {
        printf "  •  %s\n", name
    }
}')"

# Build action list: side-by-side in both orders, mirror, each-screen-only, advanced
actions="Place screens side by side (current order, left to right)
Swap screens (put the right one on the left)
Mirror (same picture on every screen)"
for o in $outputs; do
    actions="$actions
Use $o only"
done
actions="$actions
Advanced: drag screens, then tidy up"

choice="$(printf '%s\n' "$actions" | zenity --list --title="Display and monitors" \
    --text="Current layout:\n$layout\n\nPick an arrangement. This replaces any half-overlapping layout and puts the wallpaper on each screen." \
    --column="Arrangement" --hide-header --width=560 --height=420 2>/dev/null)" || exit 0

set -- $outputs
case "$choice" in
    "Place screens side by side"*)
        apply_row "$@"
        ;;
    "Swap screens"*)
        # reverse the connected list
        rev=""
        for o in "$@"; do rev="$o $rev"; done
        # shellcheck disable=SC2086
        apply_row $rev
        ;;
    "Mirror"*)
        apply_mirror
        ;;
    "Use "*)
        out="${choice#Use }"
        out="${out% only}"
        apply_single "$out"
        ;;
    "Advanced"*)
        arandr
        # arandr can leave panning / a spanning wallpaper; always tidy after
        fixup
        ;;
    *)
        exit 0
        ;;
esac

zenity --info --title="Display and monitors" --timeout=4 --width=400 \
    --text="Screens updated.\n\nThe pointer should now match the cursor, and each monitor should show a full wallpaper." \
    2>/dev/null || true
