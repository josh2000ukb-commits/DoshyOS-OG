# doshy OS bottom bar (Windows-style taskbar)
# Layout: [Start] [Files] [Terminal] [Firefox] [Discord] | running windows ... | tray | battery | clock

#-------------------------------------
# Backgrounds
# ID 1: panel
rounded = 0
border_width = 0
border_sides = T
background_color = #202020 96
border_color = #3a3a3a 100

# ID 2: active task
rounded = 4
border_width = 2
border_sides = B
background_color = #ffffff 18
border_color = #4cc2ff 100

# ID 3: task (normal / iconified / hover)
rounded = 4
border_width = 0
background_color = #ffffff 8
border_color = #000000 0
background_color_hover = #ffffff 16
border_color_hover = #000000 0
background_color_pressed = #ffffff 24

# ID 4: launcher icon hover
rounded = 4
border_width = 0
background_color = #000000 0
border_color = #000000 0
background_color_hover = #ffffff 16
border_color_hover = #000000 0
background_color_pressed = #ffffff 24

# ID 5: tooltip
rounded = 3
border_width = 1
background_color = #2b2b2b 100
border_color = #4cc2ff 60

#-------------------------------------
# Panel
panel_items = LTSBC
panel_size = 100% 42
panel_margin = 0 0
panel_padding = 4 0 6
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0.5
autohide_height = 2
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 0
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0

#-------------------------------------
# Launcher (start button + pinned apps)
launcher_padding = 2 3 4
launcher_background_id = 0
launcher_icon_background_id = 4
launcher_icon_size = 26
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 0
launcher_tooltip = 1
launcher_item_app = /usr/share/doshy/start-menu.desktop
launcher_item_app = /usr/share/applications/thunar.desktop
launcher_item_app = /usr/share/applications/xfce4-terminal.desktop
launcher_item_app = /usr/share/applications/firefox-esr.desktop
launcher_item_app = /usr/share/applications/discord.desktop

#-------------------------------------
# Taskbar (running windows)
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 6 3 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_sort_order = none
task_align = left

#-------------------------------------
# Task buttons
task_text = 1
task_icon = 1
task_centered = 0
urgent_nb_of_blink = 20
task_maximum_size = 200 36
task_padding = 8 2 6
task_font = DejaVu Sans 9
task_tooltip = 1
task_thumbnail = 0
task_font_color = #ffffff 100
task_active_font_color = #ffffff 100
task_urgent_font_color = #ffffff 100
task_iconified_font_color = #ffffff 70
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_iconified_icon_asb = 100 0 -30
task_background_id = 3
task_active_background_id = 2
task_urgent_background_id = 2
task_iconified_background_id = 3
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = none
mouse_scroll_up = toggle
mouse_scroll_down = iconify

#-------------------------------------
# System tray (network, volume, etc.)
systray_padding = 6 4 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = 1
systray_name_filter =

#-------------------------------------
# Battery (only shown on laptops)
battery_tooltip = 1
battery_low_status = 10
battery_low_cmd = notify-send "Battery low"
battery_full_cmd =
bat1_font = DejaVu Sans 8
bat2_font = DejaVu Sans 7
battery_font_color = #ffffff 100
bat1_format = %p
bat2_format =
battery_padding = 4 0
battery_background_id = 0
battery_hide = 98
battery_lclick_command =
battery_rclick_command =
battery_mclick_command =
battery_uwheel_command =
battery_dwheel_command =
ac_connected_cmd =
ac_disconnected_cmd =

#-------------------------------------
# Clock (bottom-right like Windows)
time1_format = %H:%M
time2_format = %d/%m/%Y
time1_font = DejaVu Sans 10
time2_font = DejaVu Sans 8
time1_timezone =
time2_timezone =
clock_font_color = #ffffff 100
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A, %d %B %Y
clock_tooltip_timezone =
clock_lclick_command =
clock_rclick_command =
clock_mclick_command =
clock_uwheel_command =
clock_dwheel_command =

#-------------------------------------
# Tooltips
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 5
tooltip_font_color = #ffffff 100
tooltip_font = DejaVu Sans 9
